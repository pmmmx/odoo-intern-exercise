<odoo>
    <!-- Form View -->
    <record id="view_todo_list_form" model="ir.ui.view">
        <field name="name">todo.list.form</field>
        <field name="model">todo.list</field>
        <field name="arch" type="xml">
            <form string="Todo List">
                <header>
                    <button name="action_in_progress" string="PROGRESS" type="object" invisible="state != 'draft'"/>
                    <button name="action_complete" string="DONE" type="object" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <!-- ล็อกการแก้ไขเมื่อเป็น complete -->
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="state == 'complete'"/>
                            <field name="tag_ids" widget="many2many_tags" readonly="state == 'complete'"/>
                        </group>
                        <group>
                            <field name="start_date" readonly="state == 'complete'"/>
                            <field name="end_date" readonly="state == 'complete'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="List">
                            <!-- กดเพิ่มรายการย่อยในบรรทัด -->
                            <field name="line_ids" readonly="state == 'complete'">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="is_complete" column_invisible="parent.state != 'in_progress'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attendee">
                            <field name="attendee_ids" readonly="state == 'complete'">
                                <list>
                                    <field name="name"/>
                                    <field name="login"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_todo_list_list" model="ir.ui.view">
        <field name="name">todo.list.list</field>
        <field name="model">todo.list</field>
        <field name="arch" type="xml">
            <list string="Todo List">
                <field name="name" string="Title"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Actions All Uncomplete Complete -->
    <record id="action_todo_list_all" model="ir.actions.act_window">
        <field name="name">Todo list</field>
        <field name="res_model">todo.list</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_todo_list_uncomplete" model="ir.actions.act_window">
        <field name="name">Todo list uncomplete</field>
        <field name="res_model">todo.list</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'complete')]</field>
    </record>

    <record id="action_todo_list_complete" model="ir.actions.act_window">
        <field name="name">Todo list complete</field>
        <field name="res_model">todo.list</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'complete')]</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_todo_root" name="Todo List" sequence="10"/>
    <menuitem id="menu_todo_list_all" name="All" parent="menu_todo_root" action="action_todo_list_all" sequence="10"/>
    <menuitem id="menu_todo_list_uncomplete" name="Uncomplete" parent="menu_todo_root" action="action_todo_list_uncomplete" sequence="20"/>
    <menuitem id="menu_todo_list_complete" name="Complete" parent="menu_todo_root" action="action_todo_list_complete" sequence="30"/>
</odoo>